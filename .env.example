# Kopieer naar .env en vul in. Laat MOLLIE_API_KEY leeg voor TESTMODUS
# (betaling wordt gesimuleerd, geen echte betaling nodig).

SITE_URL=https://www.rotarykerstkrans.nl

# Mollie. Leeg = ingebouwde simulator. test_… = Mollies testomgeving, live_… = echte betalingen.
MOLLIE_API_KEY=

# Beheer (/beheer)
ADMIN_PASSWORD=          # verplicht in productie (lokaal valt hij terug op een dev-waarde)
SESSION_SECRET=          # verplicht in productie: lange willekeurige tekst

# E-mail. Op de Plesk-server: MAIL_VIA=sendmail (geen wachtwoord nodig).
# Anders SMTP via SMTP_HOST/PORT/USER/PASS. Niets ingesteld = lokaal alleen loggen;
# in productie geeft het contactformulier dan een foutmelding.
MAIL_VIA=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rotary Santa Krans <support@rotarykerstkrans.nl>"
