---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { club, momenten, contactOnderwerpen, routeUrl } from '../config/site';
const verzonden = Astro.url.searchParams.get('verzonden') === '1';
// Voorselectie via een link, bijv. /contact?onderwerp=factuur
const voorkeur = contactOnderwerpen.find((o) => o.id === Astro.url.searchParams.get('onderwerp'))?.id;
const fout = Astro.url.searchParams.get('fout') === '1';
---
<Base title="Contact" active="contact" description="Vragen over je bestelling bij Rotary Santa Krans? Stuur ons een bericht via het contactformulier.">
  <section class="wrap page-hero">
    <div class="eyebrow">Contact</div>
    <h1>Vragen over je bestelling?</h1>
    <p>Stuur ons een bericht via het formulier. We reageren zo snel mogelijk.</p>
  </section>
  <section class="wrap split">
    <div class="infocard">
      <h3>Afhalen</h3>
      {[momenten.zakelijk, momenten.particulier].map((m) => (
        <div class="row">
          <span>{m.label}</span>
          <span style="text-align:right">{m.ophaalKort}, {m.ophaalTijd}<br />{m.adres} · <a href={routeUrl(m.adres)} target="_blank" rel="noopener">route ↗</a></span>
        </div>
      ))}
    </div>
    {verzonden ? (
      <div class="panel success">
        <div class="big">✓</div>
        <h2>Bedankt!</h2>
        <p class="intro" style="margin:0">We nemen zo snel mogelijk contact met je op.</p>
      </div>
    ) : (
      <form class="panel" method="post" action="/api/contact">
        <h2>Stuur een bericht</h2>
        {fout && <div class="notice" style="background:#f6e0de;margin-top:14px">Je bericht kon niet worden verstuurd. Mail ons direct via <a href={`mailto:${club.contactEmail}`}>{club.contactEmail}</a>.</div>}
        <div style="display:grid;gap:14px;margin-top:20px">
          <div class="grid2">
            <label class="field">Naam<input name="naam" required /></label>
            <label class="field">E-mail<input type="email" name="email" required /></label>
          </div>
          <label class="field">Waar gaat je vraag over?
            <select name="onderwerp" required>
              <option value="" disabled selected={!voorkeur}>Kies een onderwerp…</option>
              {contactOnderwerpen.map((o) => <option value={o.id} selected={o.id === voorkeur}>{o.label}</option>)}
            </select>
          </label>
          <label class="field">Bestelnummer (optioneel)<input name="ordernummer" placeholder="SK-2026-…" /></label>
          <label class="field">Bericht<textarea name="bericht" rows="5" required></textarea></label>
        </div>
        <div class="panel-nav"><span></span><button class="btn btn-r" type="submit">Verstuur</button></div>
      </form>
    )}
  </section>
</Base>
